{
  "name": "hollow-house-escape",
  "version": "1.0.0",
  "private": true,
  "description": "A kid-friendly Halloween escape room powered by the Claude API, with a system prompt, cost cap and guardrails.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:guardrails": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-guardrails.ts",
    "test:checks": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/check-checks.ts",
    "test": "npm run test:guardrails && npm run test:checks",
    "eval": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/eval.ts",
    "library": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local scripts/build-library.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
