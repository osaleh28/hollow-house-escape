# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com  (never commit .env.local)
ANTHROPIC_API_KEY=sk-ant-...

# Models (optional overrides)
HOUSE_MODEL=claude-sonnet-5-5
HELPER_MODEL=claude-haiku-5-5

# Cost cap: the whole app stops calling the AI once it has spent this much today (USD).
DAILY_SPEND_CAP_USD=2.00

# Per-visitor limits per day
HOUSES_PER_VISITOR_PER_DAY=5
HELPER_QUESTIONS_PER_VISITOR_PER_DAY=60
